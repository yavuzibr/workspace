{
  "name": "workspace",
  "version": "0.1.0",
  "description": "Chat with a GitHub repo, a YouTube video, or a Hugging Face model/dataset without downloading it",
  "main": "./out/main/index.js",
  "author": "yavuzibr98 <yavuzibr98@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yavuzibr98/workspace.git"
  },
  "bugs": {
    "url": "https://github.com/yavuzibr98/workspace/issues"
  },
  "homepage": "https://github.com/yavuzibr98/workspace#readme",
  "keywords": [
    "electron",
    "llm",
    "github",
    "chat",
    "huggingface"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win --dir",
    "release": "electron-vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "start": "electron-vite preview"
  },
  "build": {
    "appId": "io.github.yavuzibr98.workspace",
    "productName": "Workspace",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@octokit/plugin-throttling": "^9.3.2",
    "@octokit/rest": "^21.1.1",
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^0.469.0",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "youtube-transcript": "^1.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.1",
    "prettier": "^3.9.9",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
